# Required for the /admin dashboard (login is disabled until this is set). 8+ characters.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
SESSION_SECRET=

# Public URL of the site (canonical/OG tags + the dashboard link in alert emails).
SITE_URL=https://mikesmobiledetailingny.com

# Where new booking alerts go (Mike's inbox).
NOTIFY_EMAIL=

# Email sending (Gmail SMTP with an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Persistent database path (put on a Render disk, e.g. /var/data/mikes.sqlite).
DB_PATH=./db/mikes.sqlite
PORT=3000
